# Storage backend: "file" (default, writes .data/slates/*.json, no setup) or
# "supabase". The pipeline, the scripts and the UI all honour this.
STORE_BACKEND=file

# Supabase — Project Settings > API. Copy this file to .env.local (gitignored)
# and fill in the keys there; never commit them.
NEXT_PUBLIC_SUPABASE_URL=https://wkqdailrizifqnautazy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>
# Server-side only. Never expose to the browser; used by scripts/ and route
# handlers. Every table has RLS enabled with read-only policies, so writes
# require this key by design.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Prop line source: "synthetic" (default, works offline) or "odds-api"
PROPS_PROVIDER=synthetic

# Required only when PROPS_PROVIDER=odds-api — https://the-odds-api.com
ODDS_API_KEY=
ODDS_API_BOOKMAKERS=draftkings,fanduel
ODDS_API_REGIONS=us

# Bankroll used for Kelly sizing, in currency units
BANKROLL=10000

# National Weather Service pregame forecasts. NWS deprioritizes/blocks
# generic User-Agent strings, so a descriptive one is required — format
# recommended by their docs: "<app name> (<contact email>)". Optional: if
# unset, weather forecasting is skipped entirely (no error, no fallback).
NWS_USER_AGENT=

# Canonical base URL for absolute links in emails and (eventually) sitemap/OG
# tags — e.g. https://your-deployed-app.example. No default: required by
# scripts/send-alerts.ts, since an alert email needs a real absolute URL.
NEXT_PUBLIC_SITE_URL=

# Email alerts (scripts/send-alerts.ts) — https://resend.com. All three
# required together; unlike NWS_USER_AGENT above, the script refuses to run
# rather than silently sending nothing if any are missing, since a quietly
# no-op alert breaks the "we'll email you" promise with nothing in the UI to
# suggest anything is wrong.
RESEND_API_KEY=
# Must be an address on a domain verified in your Resend account.
ALERTS_FROM_EMAIL=
# Random secret used only to sign one-click unsubscribe links in alert
# emails (HMAC key — never sent anywhere, never logged). Generate one with
# `openssl rand -hex 32` and never reuse a secret from another purpose.
ALERTS_UNSUBSCRIBE_SECRET=
